# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Maps Geocoding API（住所→緯度経度変換）
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Bカート API（APIが利用できる場合）
BCART_API_BASE_URL=https://your-store.bcart.jp/api
BCART_API_KEY=your_bcart_api_key_here
BCART_TARGET_GROUP_ID=your_customer_group_id_here

# 管理画面アクセス用シークレット（英数字で強固なものを設定）
ADMIN_SECRET=your_strong_admin_secret_here
